{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
      // ---------------------------------------------------------------------------------------------
      // Auto-merge policy. Renovate never merges by itself, it only labels PRs "automerge".
      // .github/workflows/automerge.yaml merges those as soon as the "HelmRelease Test" passed.
      // Later rules win over earlier ones; addLabels add up.
      // Every rule that keeps a PR manual also labels it "needs-manual-merge", which the Automerge
      // workflow refuses even if a PR somehow carries "automerge" too.
      // ---------------------------------------------------------------------------------------------
      {
        "description": ["Renovate never merges by itself (overrides the trueforge preset); the Automerge workflow does"],
        "matchUpdateTypes": [
          "major", "minor", "patch", "digest", "pin", "pinDigest",
          "lockFileMaintenance", "rollback", "bump", "replacement"
        ],
        "automerge": false
      },
      {
        "description": ["Never auto-merge major updates (except Tracearr, see below)"],
        "matchUpdateTypes": ["major"],
        "matchPackageNames": ["!/tracearr/"],
        "automerge": false,
        "addLabels": ["needs-manual-merge"]
      },
      {
        "description": ["Label minor updates for auto-merge, except critical components"],
        "matchUpdateTypes": ["minor"],
        "matchPackageNames": [
          "!/siderolabs/", "!/flux-operator/", "!/flux-instance/", "!/longhorn/", "!/cilium/",
          "!/k3s-io/", "!/k3d-io/", "!/metallb/", "!/volsync/", "!/gatus/", "!/blocky/",
          "!/kromgo/", "!/metrics-server/", "!/node-feature-discovery/",
          "!/traefik/", "!/cert-manager/", "!/cloudnative-pg/"
        ],
        "addLabels": ["automerge"]
      },
      {
        "description": ["Critical components: minor updates need a manual merge"],
        "matchUpdateTypes": ["minor"],
        "matchPackageNames": [
          "/siderolabs/", "/flux-operator/", "/flux-instance/", "/longhorn/", "/cilium/",
          "/k3s-io/", "/k3d-io/", "/metallb/", "/volsync/", "/gatus/", "/blocky/",
          "/kromgo/", "/metrics-server/", "/node-feature-discovery/",
          "/traefik/", "/cert-manager/", "/cloudnative-pg/"
        ],
        "automerge": false,
        "addLabels": ["needs-manual-merge"]
      },
      {
        "description": ["Label patch updates for auto-merge, except Talos, Flux, the CI cluster and CloudNativePG"],
        "matchUpdateTypes": ["patch"],
        "matchPackageNames": [
          "!/siderolabs/", "!/flux-operator/", "!/flux-instance/", "!/k3s-io/", "!/k3d-io/",
          "!/cloudnative-pg/"
        ],
        "addLabels": ["automerge"]
      },
      {
        "description": ["Talos, Flux and the CI cluster: patch updates need a manual merge"],
        "matchUpdateTypes": ["patch"],
        "matchPackageNames": ["/siderolabs/", "/flux-operator/", "/flux-instance/", "/k3s-io/", "/k3d-io/"],
        "automerge": false,
        "addLabels": ["needs-manual-merge"]
      },
      {
        "description": ["Label digest and pin updates for auto-merge, except Talos/Kubernetes, the CI cluster and CloudNativePG"],
        "matchUpdateTypes": ["digest", "pin", "pinDigest"],
        "matchPackageNames": ["!/siderolabs/", "!/k3s-io/", "!/k3d-io/", "!/cloudnative-pg/"],
        "addLabels": ["automerge"]
      },
      // ---------------------------------------------------------------------------------------------
      // App-specific blocks (applied after the policy above, so they win)
      // ---------------------------------------------------------------------------------------------
      {
        "description": ["Tracearr: auto-merge major updates too (still tested in CI)"],
        "matchPackageNames": ["/tracearr/"],
        "matchUpdateTypes": ["major"],
        "addLabels": ["automerge"]
      },
      {
        // All 9 databases back up through spec.backup.barmanObjectStore (set by the TrueCharts cnpg
        // template), which CloudNativePG removes in 1.31. Migrate to the Barman Cloud Plugin first.
        "description": ["CloudNativePG operator: manual merge for any update, with a backup warning"],
        "matchPackageNames": ["/cloudnative-pg/"],
        "automerge": false,
        "addLabels": ["needs-manual-merge", "cnpg-backup-warning"],
        "prBodyNotes": [
          "⚠️ **CloudNativePG 1.31 removes the built-in Barman Cloud backups** (`spec.backup.barmanObjectStore`), which all CNPG databases in this cluster use for their nightly S3 backups and restores. Before merging an update that brings the operator to 1.31 or later, move the clusters to the Barman Cloud Plugin, or the database backups stop."
        ]
      },
      // ---------------------------------------------------------------------------------------------
      // Talos and Kubernetes: NEVER auto-merge, whatever the update type. Must stay last so no rule
      // above can override it. Merging bumps the tuppr plans (system-upgrade/tuppr-plans) and starts a
      // real cluster upgrade. Renovate tracks them as siderolabs/talos (github-releases) and
      // ghcr.io/siderolabs/kubelet (= the Kubernetes version); k3s-io is the CI cluster's Kubernetes.
      // The "system-upgrade" label also makes .github/workflows/automerge.yaml refuse the PR.
      // ---------------------------------------------------------------------------------------------
      {
        "description": ["Talos and Kubernetes: never auto-merge any update (manual merge only)"],
        "matchPackageNames": ["/siderolabs/", "/k3s-io/"],
        "automerge": false,
        "addLabels": ["system-upgrade", "needs-manual-merge"]
      },
      {
        "description": ["Talos and Kubernetes major updates also need approval on the Renovate dashboard"],
        "matchPackageNames": ["/siderolabs/"],
        "matchUpdateTypes": ["major"],
        "dependencyDashboardApproval": true
      },
      {
        "description": ["Python Docker image: manual merge only"],
        "matchPackageNames": ["docker.io/library/python"],
        "automerge": false,
        "addLabels": ["needs-manual-merge"]
      }
    ]
  }
